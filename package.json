{
  "name": "bravo-gaming-esports-nextjs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbopack": "next dev --turbo",
    "dev:webpack": "next dev --webpack",
    "lint": "next typegen && tsc --noEmit",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run qa:pubg-rankings && npm run qa:mahasangram",
    "build": "next build --webpack",
    "start": "next start",
    "import:first-tournament": "node --conditions=react-server --import tsx ./scripts/import-first-official-tournament.ts",
    "supabase:db:push": "npx supabase db push",
    "supabase:readiness": "node qa/supabase-readiness.mjs",
    "supabase:types": "node scripts/generate-supabase-types.mjs",
    "admin:provision": "node --env-file=.env.local --conditions=react-server --import tsx ./scripts/provision-admin.ts",
    "seed:demo": "tsx scripts/seed-demo-data.ts",
    "clear:demo": "tsx scripts/clear-demo-data.ts",
    "qa:visual:seed": "node scripts/qa-visual-seed.mjs",
    "qa:visual:cleanup": "node scripts/qa-visual-cleanup.mjs",
    "qa:pubg-rankings": "node --env-file=.env.local --conditions=react-server --import tsx ./qa/pubg-rankings-check.ts",
    "qa:mahasangram": "node --env-file=.env.local --conditions=react-server --import tsx ./qa/mahasangram-publication-check.ts",
    "qa:auth": "node --env-file=.env.local --conditions=react-server --import tsx ./qa/auth-security-check.ts",
    "qa:auth:production": "node --env-file=.env.local ./qa/auth-production-e2e.mjs",
    "qa:discord-roles": "node --import tsx ./qa/discord-role-mapping-check.ts",
    "qa:team-onboarding": "node --import tsx ./qa/team-onboarding-check.ts",
    "qa:team-reconciliation": "node --import tsx ./qa/team-reconciliation-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "lucide-react": "^1.21.0",
    "next": "^16.2.11",
    "react": "latest",
    "react-dom": "latest",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "^10.4.21",
    "pg": "^8.22.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.20.6",
    "typescript": "latest"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}
