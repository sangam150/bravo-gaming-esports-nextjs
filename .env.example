PUBG_API_KEY=your_pubg_api_key_here
PUBG_SHARD=steam
CRON_SECRET=your_cron_secret_for_vercel
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Supabase application
# Local staging uses an ignored .env.staging.local and npm run dev:staging.
# Use keys from the selected project; choose modern keys or legacy alternatives.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_optional_supabase_publishable_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL=your_pooled_postgres_connection_string
DIRECT_URL=your_direct_postgres_connection_string

# Cloudflare R2 object storage
# Public and private bucket names must be different. Proxy delivery is the
# secure default and keeps managed object keys on the application origin.
R2_ACCOUNT_ID=your_cloudflare_r2_account_id
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
R2_BUCKET_NAME=bravo-gaming-assets
R2_PRIVATE_BUCKET_NAME=bravo-gaming-private
R2_PUBLIC_BASE_URL=https://assets.bravogamingesports.com
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://assets.bravogamingesports.com
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# For direct delivery, set this to direct and keep both public base URL values
# above exactly equal. The public URL must never contain credentials.
R2_PUBLIC_DELIVERY_MODE=proxy

# Discord authentication and server-side role synchronization
# Set false to make Discord unavailable locally while email login stays usable.
# Re-enable only after the selected Supabase provider and callback are verified.
DISCORD_LOGIN_ENABLED=false
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/your-invite
BRAVO_DISCORD_GUILD_ID=your_discord_guild_id
DISCORD_BOT_TOKEN=your_private_server_only_bot_token
DISCORD_ROLE_ADMIN_ID=your_admin_role_id
DISCORD_ROLE_MODERATOR_ID=your_moderator_role_id
DISCORD_ROLE_ORGANIZER_ID=your_organizer_role_id
DISCORD_ROLE_TEAM_MANAGER_ID=your_team_manager_role_id
DISCORD_ROLE_IGL_ID=your_igl_role_id
DISCORD_ROLE_COACH_ID=your_coach_role_id
DISCORD_ROLE_PLAYER_ID=your_player_role_id
DISCORD_ROLE_BANNED_ID=your_banned_role_id
DISCORD_ROLE_SYNC_TTL_SECONDS=600
DISCORD_RELATIONAL_TEAM_AUTH_ENABLED=false

# Discord OAuth Client ID/Client Secret belong in the selected Supabase
# project's Discord provider settings, not these application variables.

# Private owner/QA settings, configured only in ignored local files.
# Never place a real password, management token or server key in this template.
QA_STAGING_ADMIN_EMAIL=
QA_STAGING_ADMIN_PASSWORD=
ADMIN_PROVISION_PASSWORD=
SUPABASE_ACCESS_TOKEN=

YOUTUBE_HANDLE=bravogamingnepal7981
YOUTUBE_CHANNEL_URL=https://www.youtube.com/@bravogamingnepal7981
