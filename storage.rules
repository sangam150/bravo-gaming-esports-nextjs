rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdminUploader() {
      return request.auth != null
        && request.auth.token.admin == true;
    }

    function isAllowedImage() {
      return request.resource != null
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif|avif)');
    }

    function isAllowedSize() {
      return request.resource != null
        && request.resource.size <= 5 * 1024 * 1024;
    }

    function canWriteImage() {
      return isAdminUploader() && isAllowedImage() && isAllowedSize();
    }

    match /team-logos/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteImage();
    }

    match /player-images/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteImage();
    }

    match /tournament-banners/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteImage();
    }

    match /match-screenshots/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteImage();
    }

    match /stream-thumbnails/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteImage();
    }

    match /sponsors/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteImage();
    }

    match /announcements/{allPaths=**} {
      allow read: if true;
      allow write: if canWriteImage();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
